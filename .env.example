# Copy to .env (cp .env.example .env). Never commit .env.
POSTGRES_DB=skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge_dev_password
DATABASE_URL=postgresql://skillbridge:skillbridge_dev_password@db:5432/skillbridge
SECRET_KEY=change-me-to-a-long-random-string
# Optional: enables LLM skill extraction (CV is PII-redacted first). Leave empty to use the offline rule-based extractor.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# CV-to-profile extraction uses one shared schema/prompt and server-side validation.
# Keep provider keys on the backend only. AI_PROVIDER selects the primary;
# AI_PROVIDER_FALLBACKS is an optional comma-separated failover order.
AI_PROVIDER=openai
AI_PROVIDER_FALLBACKS=gemini,grok,deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROK_API_KEY=
GROK_MODEL=grok-3-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=25
MAX_CV_TEXT_CHARS=25000
# Spec default cooldown is 14 days (336). 0 lets you demo the re-test immediately.
RETEST_COOLDOWN_HOURS=0
MAX_ATTEMPTS_90D=3
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
WEB_PORT=8080
# Local demo only; disable for public/production deployments.
SEED_DEMO=true

# GraphRAG question retrieval. Leave service URLs empty to use deterministic SQL fallback.
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_QUESTION_INDEX=skillbridge_questions
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
SPACY_MODEL=en_core_web_sm

# ---- CV file storage (original uploaded CVs) ----
# local = files on disk next to the SQLite DB (default, good for development)
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, MinIO) - use when you scale
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=/data/cv_files
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=prod/
# How many CV files to keep per user (older ones are deleted automatically)
KEEP_CV_DOCUMENTS_PER_USER=3

# ---- Database ----
# Local SQLite (no Docker Postgres needed): leave DATABASE_URL empty and use docker-compose.sqlite.yml,
# or run `uvicorn main:app` directly with DB_PATH=./data/skillbridge.db
# Cloud PostgreSQL later: set DATABASE_URL=postgresql://user:pass@host:5432/dbname (no code change)
